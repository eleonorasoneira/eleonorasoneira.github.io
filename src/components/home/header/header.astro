---
import SocialIcons from "../../commons/socialIcons/socialIcons.jsx";
import TypeEfect from "./typeEfect.jsx";
import MiFoto from "../../../assets/img/MiFoto.jpg";
---

<header class="relative overflow-hidden">

  <main
    class="relative z-10 flex items-center justify-center px-8 md:px-16 pt-24 pb-16"
  >

    <div class="flex flex-row items-center gap-12 max-w-6xl w-full">

      <!-- TEXTO -->
      <div class="text-left max-w-2xl flex-1">

        <h1 class="text-4xl md:text-6xl font-bold text-white">
          Hello! I'm<br />
          Eleonora Soneira
        </h1>

        <TypeEfect client:visible />

        <p
          class="text-xs md:text-xl text-white max-w-sm md:max-w-xl font-semibold mt-3"
        >
          Junior Data Analyst with additional experience in IT Support,
          hardware, software and user assistance. I combine analytical
          thinking, problem solving and effective communication with experience
          working in multicultural environments. <br />
          Explore my projects!
        </p>
        <br />
        <a
          target="_blank"
          href="https://docs.google.com/document/d/1Db0ZGGUdaI4TUlr6TWWR6pKto14oLSKmvopuXFMD9Uw/edit?tab=t.0"
          class="inline-block px-6 py-3 bg-primary hover:bg-secondary mt-3 text-white font-semibold rounded-3xl transition-all duration-150 active:translate-0.5"
        >
          Full Resume
        </a>

      </div>

      <!-- FOTO -->
      <div class="flex-shrink-0 relative z-50">
        <img
          src={MiFoto.src}
          alt="Foto de Eleonora"
          class="w-56 h-56 md:w-80 md:h-80 object-cover rounded-full"
        />
      </div>

    </div>

  </main>

</header>