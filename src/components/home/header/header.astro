---
import SocialIcons from "../../commons/socialIcons/socialIcons.jsx";
import TypeEfect from "../header/typeEfect.jsx";
---

<header class="relative h-screen overflow-hidden">

  <main
    class="relative z-10 flex flex-col items-start justify-center h-full text-center px-4"
  >
    <h1 class="text-4xl md:text-6xl font-bold text-white text-shadow: none">
      Hello! I'am Eleonora Soneira
    </h1>

    <TypeEfect client:visible />

    <p
      class="text-xs md:text-xl text-white max-w-sm md:max-w-xl font-semibold mt-3"
    >
      Junior Data Analyst With additional experience in IT Support, hardware, software and user assistance. 
      I combine analytical thinking, problem solving and effective communication. 
      Experience working in multicultural environments. 
      Explore my projects, learn a little more about me, if you want to join us contact, I'm just a message away!
    </p>
    <SocialIcons client:visible />
    <a
      target="_blank"
      href="https://docs.google.com/document/d/1Db0ZGGUdaI4TUlr6TWWR6pKto14oLSKmvopuXFMD9Uw/edit?tab=t.0"
      class="px-6 py-3 bg-primary hover:bg-secondary mt-3 text-white font-semibold rounded-3xl transition-all duration-150
          active:translate-0.5 active:drop-shadow-none"
    >
      Resume
    </a>
  </main>
</header>
